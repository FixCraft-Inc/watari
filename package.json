{
  "name": "watari",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "bin": {
    "watari": "./src/watari/index.ts"
  },
  "scripts": {
    "dev": "bun run --preload=@opentui/solid/preload src/watari/index.ts",
    "preview": "bun run --preload=@opentui/solid/preload scripts/preview-ui.tsx",
    "typecheck": "tsc --noEmit",
    "test": "DEBUG= bun test --preload=@opentui/solid/preload tests/",
    "check": "bun run typecheck && bun run test",
    "build": "bun run scripts/build.ts",
    "generate:codex": "bun run scripts/generate-codex.ts",
    "install:cli": "bun run build && mkdir -p \"$HOME/.local/bin\" && ln -sfn \"$PWD/dist/watari\" \"$HOME/.local/bin/watari\" && \"$HOME/.local/bin/watari\" --version"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "0.21.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "@anthropic-ai/sdk": "0.120.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opentui/core": "0.5.7",
    "@opentui/solid": "0.5.7",
    "solid-js": "1.9.12",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@typescript/typescript-linux-x64": "7.0.2",
    "typescript": "7.0.2"
  }
}
